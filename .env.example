# Local-only defaults. Copy to .env.local; never commit real secrets.
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 1D session clients/proxy; public homepage builds without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: authorized staff mutations and bounded published public projections.
# Never prefix privileged keys with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Phase 4A: fixed public-site binding; never use visitor input or a QA operator.
PUBLIC_OPERATOR_ID=
PUBLIC_HOMEPAGE_PRODUCT_SLUG=shkodra-day-tour

# Server-only random signing secret, at least 32 characters; local setup generated privately.
CHECKOUT_SESSION_SECRET=

# Explicit launch gate: only effective with APP_ENV=production and a public HTTPS site URL.
SITE_INDEXING_ENABLED=false

# Server-only transactional booking email. Never enable with real recipients in development.
EMAIL_ENABLED=false
EMAIL_TEST_RECIPIENT=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sightseeing Shkodra <tickets@sightseeingshkodra.app>
BOOKING_OWNER_EMAIL=
BOOKING_REPLY_TO_EMAIL=
# Explicit UTC activation timestamp (ISO 8601); events older than this are not sent.
EMAIL_START_AT=
# Random secret of at least 32 characters, used only by the protected email scheduler.
CRON_SECRET=

# Read-only published stops from the independent map, for optional destination references.
LIVE_MAP_SUPABASE_URL=
LIVE_MAP_PUBLISHABLE_KEY=
LIVE_MAP_PROJECT_SLUG=sightseeing-shkodra

# Explicit opt-in only after a single external scheduler is reviewed and configured.
BACKGROUND_DELIVERY_ENABLED=false
# Vercel Hobby: no active Vercel cron configuration.
# Keep workers disabled. Configure server secrets in Vercel environment settings.
# EMAIL_START_AT gates both new events and claims after the worker-readiness migration.
# Before test/live cutover, disable sending and let active runs/leases settle.

# Admin inbox + push use the existing event outbox, independently of EMAIL_ENABLED.
# Apply 20261005000100_admin_notifications.sql before activation.
ADMIN_NOTIFICATIONS_ENABLED=false
# Explicit activation instant, e.g. 2026-10-05T12:00:00Z. No historical push by default.
ADMIN_NOTIFICATIONS_START_AT=
ADMIN_PUSH_ENABLED=false
# Generate with: node scripts/generate-admin-vapid.mjs (writes ignored private file).
# These are server environment values; only the public key is returned to authorized Admin.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Reuses PUBLIC_OPERATOR_ID, SUPABASE_SECRET_KEY, NEXT_PUBLIC_SITE_URL and CRON_SECRET.

# Vercel: copy the required values to Production environment settings, then rebuild.
# This code uses NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, not NEXT_PUBLIC_SUPABASE_ANON_KEY.
# npm run build checks essential bindings only when VERCEL_ENV=production.
# Keep optional workers disabled in Preview. Netlify schedules do not run on Vercel.
# See docs/VERCEL-DEPLOYMENT-AUDIT.md and docs/VERCEL-ENVIRONMENT-INVENTORY.md.

# Preview-only isolation guard (project identifiers, not secrets).
# Production project ref must identify the actual live project; Preview ref must differ.
PREVIEW_SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_PROJECT_REF=
