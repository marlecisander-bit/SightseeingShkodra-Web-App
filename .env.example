# Local-only defaults. Copy to .env.local; never commit real secrets.
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 1D session clients/proxy; public homepage builds without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: authorized staff mutations and bounded published public projections.
# Never prefix privileged keys with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Phase 4A: fixed public-site binding; never use visitor input or a QA operator.
PUBLIC_OPERATOR_ID=
PUBLIC_HOMEPAGE_PRODUCT_SLUG=shkodra-day-tour

# Payment, notification and tracking settings are added in their own phases.
