# Local-only defaults. Copy to .env.local; never commit real secrets.
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reserved for Phase 1D auth integration; not required to build this foundation.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix privileged keys with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Payment, notification and tracking settings are added in their own phases.
