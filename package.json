{
  "name": "sightseeing-shkodra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:db": "tsx --test tests/database/*.test.mjs",
    "test:identity": "tsx --test tests/identity/*.test.mjs",
    "test": "npm run test:identity && npm run test:integrations && npm run test:db && npm run test:postgres",
    "test:integrations": "tsx --conditions=react-server --test tests/integrations/*.test.mjs",
    "fixtures:preview": "node scripts/preview-fixtures.mjs",
    "notifications:preview": "node --import tsx scripts/preview-booking-confirmation.mjs",
    "test:postgres": "node --test tests/postgres/*.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "leaflet": "1.9.4",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "pg": "8.23.0",
    "tsx": "4.23.14",
    "typescript": "5.9.3"
  }
}
